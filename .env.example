# Copia este archivo como .env (make init lo hace por ti).
# .env NO se sube a Git.

# Versiones (alineadas con Hostinger)
PS_IMAGE_TAG=8.2.8-8.1-apache
MARIADB_VERSION=10.11

# Puertos locales
PS_PORT=8090
PMA_PORT=8091
