# =====================================================================
# Sharkness — .gitignore
# El sitio completo de PrestaShop vive en /www y se versiona (incluido
# vendor/ y modules/), porque en Hostinger el repo ES el sitio.
# Se ignoran: secretos, caché, logs y DATOS (imágenes subidas, backups).
# =====================================================================

# --- Entorno local / secretos ----------------------------------------
/.env
.DS_Store
node_modules/
/backups/*
!/backups/.gitkeep

# --- Configuración por entorno (credenciales de BD, claves) ----------
/www/app/config/parameters.php
/www/app/config/parameters.yml
/www/app/config/parameters.old.yml
/www/config/settings.inc.php
/www/config/settings.old.php
/www/install.lock
/www/.htaccess
/www/robots.txt
/www/*sitemap.xml

# --- Caché y archivos temporales -------------------------------------
*.log
/www/var/cache/*
/www/var/logs/*
/www/var/sessions/*
/www/cache/*
!/www/cache/index.php
/www/themes/*/cache/*
/www/themes/*/assets/cache/*
/www/config/xml/*
/www/config/themes/*

# --- Datos (viven en producción, no en Git) ---------------------------
# Imágenes de productos, categorías, marcas, etc.
/www/img/p/*
/www/img/c/*
/www/img/m/*
/www/img/su/*
/www/img/st/*
/www/img/s/*
/www/img/l/*
/www/img/co/*
/www/img/cms/*
/www/img/tmp/*
!/www/img/*/index.php
# Archivos subidos por clientes / descargas
/www/upload/*
!/www/upload/.htaccess
/www/download/*
!/www/download/.htaccess
!/www/download/index.php

# --- Carpetas del back office con datos (el nombre del admin varía) --
/www/admin*/backups/*
/www/admin*/import/*
/www/admin*/export/*
/www/admin*/autoupgrade/*
!/www/admin*/*/index.php
!/www/admin*/*/.htaccess
